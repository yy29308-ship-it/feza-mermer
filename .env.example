# Bu dosyayı ".env.local" adıyla kopyalayın ve değerleri doldurun.
# .env.local dosyası git'e gönderilmez, güvenlidir.

# Veritabanı bağlantısı (MySQL).
# XAMPP varsayılanı: kullanıcı root, parola yok, port 3306.
# Parola koyduysanız root: ile @ arasına yazın.
# connect_timeout=2 : MySQL kapalıysa formu bekletmeden devam et.
DATABASE_URL="mysql://root@localhost:3306/feza_mermer?connect_timeout=2"

# İletişim formunun e-posta gönderebilmesi için gerekli.
# https://resend.com adresinden ücretsiz hesap açıp API anahtarı alın.
# Boş bırakırsanız site yine çalışır; iletişim sayfasında form yerine
# telefon/WhatsApp kartı gösterilir.
RESEND_API_KEY=

# Form mesajlarının GÖNDERİLECEĞİ adres (sizin okuduğunuz kutu).
CONTACT_TO_EMAIL=

# Form mesajlarının GÖNDERİCİ adresi.
# Resend'de doğruladığınız alan adına ait olmalı, ör: site@fezamermer.com
# Kendi alan adınızı henüz doğrulamadıysanız test için onboarding@resend.dev kullanın.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Sitenin canlı adresi (sitemap ve paylaşım önizlemesi için).
NEXT_PUBLIC_SITE_URL=https://www.fezamermer.com

